# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# REPLICATE_API_TOKEN: Required for real Replicate Text-to-Video AI model predictions (e.g., Wan2.1, CogVideoX, AnimateDiff).
# Users configure this via the Secrets panel in the AI Studio UI.
# REPLICATE_API_TOKEN=r8_your_replicate_token_here

# HINDI_VOICE_API_KEY: Optional voice provider API key for Hindi voice synthesis.
# HINDI_VOICE_API_KEY=your_voice_api_key_here
